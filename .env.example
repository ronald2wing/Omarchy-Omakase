# Copy to .env, fill in the keys, then: chmod 600 .env

# Required. Authenticates Yelp search for bin/collect_city.rb and
# bin/refresh_yelp_fields.rb.
# Get a key at https://www.yelp.com/developers/v3/manage_app
YELP_API_KEY=your_yelp_api_key

# Optional. Used by bin/backfill_websites.rb for official-website lookup.
# Get a key at https://foursquare.com/developers/apps
FOURSQUARE_API_KEY=your_foursquare_api_key
